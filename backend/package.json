{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "generate": "prisma generate",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "studio": "prisma studio",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "tsx --test src/tests/*.test.ts",
    "check": "biome check .",
    "lint": "biome lint .",
    "check:fix": "biome check --write .",
    "format": "biome format --write .",
    "setup": "node scripts/setup.mjs && npm run db:setup",
    "db:setup": "npm run generate && npm run migrate:deploy"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "cookie": "^1.0.2",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "google-auth-library": "^11.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.6",
    "@types/supertest": "^6.0.3",
    "prisma": "6.19.3",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "~5.9.2",
    "@biomejs/biome": "2.5.6"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2"
  }
}
