{
  "format_on_save": "on",
  "formatter": {
    "external": {
      "command": "node",
      "arguments": [
        ".zed/format.mjs",
        "{buffer_path}"
      ]
    }
  },
  "languages": {
    "JavaScript": {
      "format_on_save": "on",
      "formatter": {
        "external": {
          "command": "node",
          "arguments": [
            ".zed/format.mjs",
            "{buffer_path}"
          ]
        }
      },
      "language_servers": [
        "biome",
        "tailwindcss-language-server",
        "..."
      ],
      "code_actions_on_format": {}
    },
